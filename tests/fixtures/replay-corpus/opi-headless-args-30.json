          "expected_text": "fn model_from_args(args: &HeadlessArgs) -> Result<String, ModelError> {\n    let Some(model) = args.model.as_deref() else {\n        return Err(ModelError::Missing);\n    };\n    let model = model.trim();\n    let valid_chars = model.chars().all(|character| {\n        character.is_ascii_alphanumeric()\n            || matches!(character, '.' | '_' | ':' | '/' | '@' | '+' | '-')\n    });\n    let Some((provider, id)) = model.split_once('/') else {\n        return Err(ModelError::Invalid);\n    };\n    if model.is_empty()\n        || model.len() > MAX_MODEL_BYTES\n        || !valid_chars\n        || !provider.starts_with(\"target-gw-\")\n        || provider.len() == \"target-gw-\".len()\n        || id.is_empty()\n    {\n        return Err(ModelError::Invalid);\n    }\n    Ok(model.to_owned())\n}"
