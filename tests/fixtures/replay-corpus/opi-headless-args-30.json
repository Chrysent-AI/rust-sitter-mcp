          "expected_text": "fn synthetic_intervention_from_ui(method: &str, fields: &Value) -> Option<NewIntervention> {\n    if !matches!(method, \"select\" | \"confirm\" | \"input\" | \"editor\") {\n        return None;\n    }\n    let title = bounded_synthetic_text(fields.get(\"title\").and_then(Value::as_str), 16_384);\n    let message = bounded_synthetic_text(fields.get(\"message\").and_then(Value::as_str), 16_384);\n    let question = title\n        .as_deref()\n        .or(message.as_deref())\n        .unwrap_or(\"An extension UI request requires a human response.\");\n    // Context retains the normalized message only when the normalized title is\n    // the question, so it is always bounded independently of the raw event.\n    let context = title\n        .as_deref()\n        .zip(message.as_deref())\n        .filter(|(_, message)| *message != question)\n        .map(|(_, message)| message.to_owned());\n    let choices = match method {\n        \"select\" => fields\n            .get(\"options\")\n            .and_then(Value::as_array)\n            .filter(|options| options.len() <= MAX_CHOICES)\n            .and_then(|options| {\n                options\n                    .iter()\n                    .map(Value::as_str)\n                    .map(|option| bounded_synthetic_text(option, MAX_CHOICE_LABEL_BYTES))\n                    .collect::<Option<Vec<_>>>()\n            })\n            .map(|options| {\n                options\n                    .into_iter()\n                    .enumerate()\n                    .map(|(index, label)| InterventionChoice {\n                        id: format!(\"option-{}\", index + 1),\n                        label,\n                        description: None,\n                    })\n                    .collect()\n            }),\n        \"confirm\" => Some(vec![\n            InterventionChoice {\n                id: \"confirmed\".into(),\n                label: \"Confirm\".into(),\n                description: None,\n            },\n            InterventionChoice {\n                id: \"declined\".into(),\n                label: \"Decline\".into(),\n                description: None,\n            },\n        ]),\n        \"input\" | \"editor\" => None,\n        _ => unreachable!(\"waiting UI methods were checked above\"),\n    };\n    let mut intervention = NewIntervention {\n        reason: \"An extension UI request requires human input.\".into(),\n        question: question.to_owned(),\n        context,\n        choices,\n    };\n    // All single fields above are normalized to their storage bounds. Keep the\n    // longest source-ordered prefix whose serialized choices fit the frozen\n    // aggregate column, the only remaining schema-fit failure.\n    while !intervention_fits_schema(&intervention) {\n        let choices = intervention.choices.as_mut()?;\n        choices.pop()?;\n    }\n    Some(intervention)\n}"
        },
