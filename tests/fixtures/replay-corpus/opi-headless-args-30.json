          "expected_text": "fn prompt_from_args_with_reader(\n    args: &HeadlessArgs,\n    stdin_is_tty: bool,\n    stdin: impl Read,\n) -> Result<String, PromptError> {\n    let explicit_sources = args.prompt.len() + args.prompt_file.len();\n    if explicit_sources > 1 {\n        return Err(PromptError::Duplicate);\n    }\n\n    let text = match (args.prompt.first(), args.prompt_file.first()) {\n        (Some(prompt), None) => prompt.clone(),\n        (None, Some(path)) if path == Path::new(\"-\") => read_prompt_input(stdin)?,\n        (None, Some(path)) => {\n            let file = std::fs::File::open(path)\n                .map_err(|error| PromptError::Unreadable(error.to_string()))?;\n            read_prompt_input(file)?\n        }\n        (None, None) if !stdin_is_tty => read_prompt_input(stdin)?,\n        (None, None) => return Err(PromptError::Missing),\n        (Some(_), Some(_)) => unreachable!(\"duplicate sources were rejected above\"),\n    };\n\n    validate_prompt(text)\n}"
        },
