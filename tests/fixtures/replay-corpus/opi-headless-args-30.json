          "expected_text": "fn read_prompt_input(input: impl Read) -> Result<String, PromptError> {\n    let mut bytes = Vec::with_capacity(MAX_PROMPT_BYTES.min(8_192));\n    input\n        .take((MAX_PROMPT_BYTES + 1) as u64)\n        .read_to_end(&mut bytes)\n        .map_err(|error| PromptError::Unreadable(error.to_string()))?;\n    if bytes.len() > MAX_PROMPT_BYTES {\n        return Err(PromptError::TooLarge);\n    }\n    String::from_utf8(bytes).map_err(|_| PromptError::InvalidUtf8)\n}"
        },
